#!/usr/bin/env zsh

#sewal
img="$1"

# Fallback if no argument passed
if [ -z "$img" ]; then
  img=$(find ~/HDD/Pictures/wallpaper -type f | shuf -n 1)
fi

# Ensure daemon is running
pgrep -x "awww-daemon" >/dev/null || (
  awww-daemon &
  sleep 0.5
)

# Set wallpaper (awww with animation)
awww img "$img" --transition-type fade --transition-duration 2

# Generate colors
wal -i "$img"

#refresh foot
pkill -SIGUSR1 -x foot

#cava refresh
pkill -USR1 -x cava

echo "Applied wallpaper + theme: $img"
